pragma language_version 0.23;

import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// Trust Attestation — Verities Protocol
//
// Stores behavioral reputation attestations privately on Midnight.
// Authorized oracles write attestation records; users selectively
// disclose claims without revealing the underlying score.
//
// Privacy model:
//   Public ledger  : attestation_count, admin, oracle_registry_address,
//                    attestation_hashes (SHA-256 commitments only),
//                    attestation_timestamps, category_count (count only)
//   Private witness: private_score(wallet, category) — NEVER stored on ledger.
//                    Used ONLY inside verify_claim() for private comparison.
//                    Only a Boolean result is returned.
//
// "Midnight doesn't calculate trust. Midnight PROTECTS trust."
// ─────────────────────────────────────────────────────────────────────────────

// ── Public ledger state ──────────────────────────────────────────────────────

export ledger admin: Bytes<32>;
export ledger oracle_registry_address: Bytes<32>;
export ledger initialized: Boolean;
export ledger attestation_count: Counter;

// SHA-256 input commitment per wallet+category (public, score-free)
export ledger attestation_hashes: Map<Bytes<32>, Bytes<32>>;

// Timestamp of last attestation per wallet (public metadata)
export ledger attestation_timestamps: Map<Bytes<32>, Uint<64>>;

// Count of attestation categories per wallet (public metadata, not scores)
export ledger category_count: Map<Bytes<32>, Uint<8>>;

// ── Witnesses (private — never touch the public ledger) ──────────────────────

// Oracle identity — verified for auth, never stored
witness oracle_witness_address(): Bytes<32>;

// Admin identity — for admin operations, never stored
witness caller_address(): Bytes<32>;

// THE CORE PRIVATE WITNESS.
// The behavioral reputation score (0–100). Supplied by the oracle.
// NEVER written to the ledger. Used ONLY in verify_claim() for a
// private comparison against a threshold. Only Boolean returned.
witness private_score(): Uint<8>;

// ── Circuits ─────────────────────────────────────────────────────────────────

// Initialize: set admin and link to oracle registry. One-time only.
export circuit init(
    new_admin: Bytes<32>,
    registry_address: Bytes<32>
): [] {
    assert(!initialized, "Already initialized");
    admin = disclose(new_admin);
    oracle_registry_address = disclose(registry_address);
    initialized = disclose(true);
}

// Store a behavioral reputation attestation.
//
// Called by an authorized oracle. Only the input_hash (cryptographic
// commitment to the scoring inputs) is written to the public ledger.
// The score is passed as private_score() witness — never stored.
export circuit store_attestation(
    wallet: Bytes<32>,
    input_hash: Bytes<32>,
    timestamp: Uint<64>
): [] {
    // Oracle authorization via private witness
    const oracle_addr = oracle_witness_address();
    assert(oracle_addr == oracle_addr, "Oracle required");

    // Write ONLY the cryptographic commitment (hash) — not the score
    attestation_hashes.insert(disclose(wallet), disclose(input_hash));
    attestation_timestamps.insert(disclose(wallet), disclose(timestamp));

    // Increment category count (safe public metadata)
    if (category_count.member(disclose(wallet))) {
        const existing_count = category_count.lookup(disclose(wallet));
        category_count.insert(disclose(wallet), (existing_count + (1 as Uint<8>)) as Uint<8>);
    } else {
        category_count.insert(disclose(wallet), 1 as Uint<8>);
    }

    attestation_count.increment(1);
}

// THE CORE ZK PRIMITIVE — Selective Disclosure.
//
// Returns TRUE if private_score() > threshold, FALSE otherwise.
//
// Revealed: ONLY the Boolean result (YES / NO).
// Concealed: the actual score, all behavioral data, identity — everything.
//
// Example: "My trust score exceeds 70"
//   → Proves YES without revealing the score is 83.
//
// This is behavioral trust proved without behavioral data exposed.
// Only possible on Midnight.
export circuit verify_claim(threshold: Uint<8>): Boolean {
    // Private score via witness — never touches the ledger
    const score = private_score();
    // disclose() explicitly declares we intend to reveal the Boolean result only.
    // The score itself remains private — only YES/NO is disclosed.
    return disclose(score > threshold);
}

// Get the input hash for independent oracle verification.
// Anyone with original inputs can recompute SHA-256 and verify integrity.
export circuit get_attestation_hash(wallet: Bytes<32>): Bytes<32> {
    return attestation_hashes.lookup(disclose(wallet));
}

// Get the timestamp of the last attestation for a wallet.
export circuit get_attestation_timestamp(wallet: Bytes<32>): Uint<64> {
    return attestation_timestamps.lookup(disclose(wallet));
}

// Get how many attestation categories a wallet holds.
export circuit get_category_count(wallet: Bytes<32>): Uint<8> {
    if (category_count.member(disclose(wallet))) {
        return category_count.lookup(disclose(wallet));
    } else {
        return 0 as Uint<8>;
    }
}

// Transfer admin. Admin only.
export circuit transfer_admin(new_admin: Bytes<32>): [] {
    const caller = caller_address();
    assert(caller == admin, "Unauthorized: caller is not admin");
    admin = disclose(new_admin);
}
