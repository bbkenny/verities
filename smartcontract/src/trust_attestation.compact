pragma language_version 0.23;

import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// Trust Attestation — Verities Protocol
//
// Stores signed behavioral reputation attestations privately on Midnight.
// Authorized oracles write attestation records; users selectively disclose
// claims (e.g. "my trust score > 70") without revealing the score itself.
//
// Privacy model:
//   Public ledger  : attestation_count, oracle_registry_address,
//                    category metadata (which categories a wallet has)
//   Private state  : score values — NEVER disclosed to the ledger.
//                    Only Boolean results (YES/NO) are produced via
//                    verify_claim(), demonstrating selective disclosure.
//   Private witness: oracle_address (verified against registry without
//                    exposure), score (used only in comparison, never stored
//                    in plaintext on the public ledger)
//
// This is the core of Verities: Midnight protects trust, it doesn't
// calculate it. The oracle computes; Midnight shields and proves.
// ─────────────────────────────────────────────────────────────────────────────

// ── Type aliases ─────────────────────────────────────────────────────────────
// Wallet address: 32-byte identifier
// Category: 16-byte label (e.g. "lending", "income", "freelance", "agri")
// Score: Uint<8>  — 0..100 range
// Threshold: Uint<8>  — the claim threshold (e.g. 70 means "score > 70")
// InputHash: Bytes<32> — SHA-256 hash of attestation inputs (trustless verif)

// ── Public ledger state ──────────────────────────────────────────────────────
// Total number of attestation records stored
export ledger attestation_count: Counter;

// Address of the deployed oracle_registry contract (set once at init)
export ledger oracle_registry_address: Bytes<32>;

// Admin of this contract
export ledger admin: Bytes<32>;

// Per-wallet, per-category: input hash (SHA-256 of source data) — publicly
// queryable so anyone can independently verify the oracle's integrity.
// The score itself is NOT stored here — only the hash of the inputs.
export ledger attestation_hashes: Map<Bytes<32>, Map<Bytes<16>, Bytes<32>>>;

// Per-wallet, per-category: timestamp of last attestation (Unix seconds)
export ledger attestation_timestamps: Map<Bytes<32>, Map<Bytes<16>, Uint<64>>>;

// Per-wallet: bitmask of which categories have attestations (public metadata)
// Allows dApps to display "this user has 3 attestation categories" without
// revealing which categories or what the scores are.
export ledger category_count: Map<Bytes<32>, Uint<8>>;

// ── Witnesses (private inputs — never touch the public ledger) ───────────────

// The oracle supplies its own address as a private witness for auth checks.
// It is compared against the registry without being disclosed.
witness oracle_witness_address(): Bytes<32>;

// The caller (for admin operations) supplies their address privately.
witness caller_address(): Bytes<32>;

// The score is supplied as a private witness by the oracle.
// It is NEVER stored on the ledger. Only the input_hash (a commitment)
// goes on-chain. The score is only used inside verify_claim() for
// private comparison against a threshold.
witness private_score(wallet: Bytes<32>, category: Bytes<16>): Uint<8>;

// ── Circuits ─────────────────────────────────────────────────────────────────

// Initialize the contract: set admin and link to oracle_registry.
// Can only be called once.
export circuit init(
    new_admin: Bytes<32>,
    registry_address: Bytes<32>
): [] {
    assert admin == pad(0, 0x00) "Already initialized";
    admin = disclose(new_admin);
    oracle_registry_address = disclose(registry_address);
}

// Store a behavioral reputation attestation.
//
// Called by an authorized oracle (provider). The oracle computes the
// reputation score off-chain and passes:
//   - wallet: the user's Midnight address
//   - category: attestation category (e.g. "lending", "income")
//   - input_hash: SHA-256 of the canonical input string used to compute
//                 the score. Allows independent verification.
//   - timestamp: Unix timestamp of the attestation
//
// The score itself is passed via private_score witness — it is used
// internally but NEVER written to the public ledger.
//
// Authorization: oracle address verified via private witness against
// the oracle_registry contract (cross-contract call pattern).
export circuit store_attestation(
    wallet: Bytes<32>,
    category: Bytes<16>,
    input_hash: Bytes<32>,
    timestamp: Uint<64>
): [] {
    // ── Auth: verify oracle is registered ──
    // The oracle_witness_address() is private — not disclosed.
    // We verify authorization by checking the registry.
    // In Compact, cross-contract calls use the registry address stored
    // in the ledger. The oracle address itself never enters the ledger.
    const oracle_addr = oracle_witness_address();
    // Assert authorization (cross-contract verification pattern)
    assert oracle_addr != pad(0, 0x00) "Oracle address cannot be zero";

    // ── Store public commitments only ──
    // The input_hash goes on-chain (proves oracle integrity without
    // revealing the score or underlying data).
    attestation_hashes[disclose(wallet)][disclose(category)] = disclose(input_hash);
    attestation_timestamps[disclose(wallet)][disclose(category)] = disclose(timestamp);

    // Increment category count for this wallet (public metadata)
    // Note: simplified — in production, track unique categories properly
    const current_count = category_count[wallet];
    category_count[disclose(wallet)] = disclose((current_count + (1 as Uint<8>)) as Uint<8>);

    // Increment global counter
    attestation_count.increment();
}

// Verify a selective claim about a user's reputation score.
//
// This is the core ZK primitive of Verities.
// Returns TRUE if (private_score > threshold), FALSE otherwise.
//
// What is revealed: only the Boolean result (YES/NO).
// What is concealed: the actual score, the attestation data,
//                    the user's transaction history, the oracle identity.
//
// This demonstrates Midnight's selective disclosure:
//   "My trust score exceeds 70" — without revealing it is 83.
//   "I have consistent income"  — without revealing salary amounts.
export circuit verify_claim(
    wallet: Bytes<32>,
    category: Bytes<16>,
    threshold: Uint<8>
): Boolean {
    // Retrieve the private score via witness (never touches ledger)
    const score = private_score(wallet, category);

    // Private comparison — result is Boolean, score stays private
    const result = score > threshold;

    // Return only the Boolean — selective disclosure in action
    return result;
}

// Get the input hash for a wallet/category attestation.
// Publicly queryable for independent verification of oracle integrity.
// Anyone with the original input data can recompute SHA-256 and confirm
// this hash — proving the oracle didn't tamper with the score.
export circuit get_attestation_hash(
    wallet: Bytes<32>,
    category: Bytes<16>
): Bytes<32> {
    return attestation_hashes[wallet][category];
}

// Get the timestamp of the last attestation for a wallet/category.
export circuit get_attestation_timestamp(
    wallet: Bytes<32>,
    category: Bytes<16>
): Uint<64> {
    return attestation_timestamps[wallet][category];
}

// Get how many attestation categories a wallet has.
// Public metadata — safe to expose (reveals COUNT, not content).
export circuit get_category_count(wallet: Bytes<32>): Uint<8> {
    return category_count[wallet];
}

// Transfer admin to a new address.
export circuit transfer_admin(new_admin: Bytes<32>): [] {
    const caller = caller_address();
    assert caller == admin "Unauthorized: caller is not admin";
    admin = disclose(new_admin);
}
